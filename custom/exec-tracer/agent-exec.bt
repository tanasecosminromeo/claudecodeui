// agent-exec.bt: every process started under a `claude` or `claude-swap` process, and its exit.
// Run as root by agent-exec-tracer.py, which turns these lines into per-user JSONL:
//   A <pid> <i> <arg>                         one argv element (i = 0..11)
//   X <pid> <ppid> <uid> <root> <lparent> <n>  exec header, after that pid's A lines
//   Z <pid> <code> <sig>                      exit of a tracked process (thread-group leader)
// root    = nearest ancestor whose comm is claude / claude-swap
// lparent = nearest ancestor that is itself tracked (or root): bridges subshells that
//           forked but never exec'd, which the tracer never sees.
// Anything without such an ancestor is never printed.

BEGIN { printf("R\n"); }

tracepoint:syscalls:sys_enter_execve
{
  $t = curtask->real_parent;
  $root = 0;
  $lp = 0;
  unroll(20) {
    if ($root == 0 && $t->pid > 1) {
      if ($lp == 0 && @tracked[$t->tgid] == 1) { $lp = $t->tgid; }
      if ($t->comm == "claude" || $t->comm == "claude-swap") { $root = $t->tgid; }
      $t = $t->real_parent;
    }
  }
  if ($root != 0) {
    if ($lp == 0) { $lp = $root; }
    @tracked[pid] = 1;
    $n = 0;
    unroll(12) {
      if (*(args->argv + $n) != 0) {
        printf("A %d %d %s\n", pid, $n, str(*(args->argv + $n)));
        $n++;
      }
    }
    printf("X %d %d %d %d %d %d\n", pid, curtask->real_parent->tgid, uid, $root, $lp, $n);
  }
}

tracepoint:sched:sched_process_exit
/ pid == tid && @tracked[pid] == 1 /
{
  printf("Z %d %d %d\n", pid, (curtask->exit_code >> 8) & 0xff, curtask->exit_code & 0x7f);
  delete(@tracked[pid]);
}

END { clear(@tracked); }
