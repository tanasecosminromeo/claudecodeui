[Unit]
Description=Agent exec tracer: logs processes started by claude / claude-swap, one JSONL file per user
Documentation=file:///usr/local/lib/agent-exec-tracer/README.md
After=local-fs.target

[Service]
Type=simple
Environment=BPFTRACE_MAX_STRLEN=200
ExecStart=/usr/bin/python3 /usr/local/lib/agent-exec-tracer/agent-exec-tracer.py --dir /var/log/agent-exec
Restart=always
RestartSec=5
Nice=5

[Install]
WantedBy=multi-user.target
