[Unit]
Description=CloudCLI public artefact shares (/share/*) - localhost, behind the tunnel
After=network-online.target
Wants=network-online.target

# Installed by `make share-install`, which fills in __APP__ (the checkout) and __NODE__.
[Service]
Type=simple
WorkingDirectory=__APP__
EnvironmentFile=-__APP__/.env
ExecStart=__NODE__ __APP__/custom/share/server.mjs
Restart=on-failure
RestartSec=3
# Read-only service: it never writes, and only needs ~/shares and the checkout.
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes

[Install]
WantedBy=default.target
