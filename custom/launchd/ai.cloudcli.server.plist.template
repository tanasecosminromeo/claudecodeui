<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rendered into ~/Library/LaunchAgents/ by `make service` (__APP__ = repo root, __HOME__ = $HOME). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.cloudcli.server</string>

    <key>ProgramArguments</key>
    <array>
        <string>__APP__/custom/launchd/cloudcli-service.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__APP__</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/cloudcli/server.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/cloudcli/server.error.log</string>
</dict>
</plist>
